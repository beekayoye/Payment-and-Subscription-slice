# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/subscription_system?schema=public"

# ============================================================================
# Flutterwave — sandbox / test mode only (locked: .agents/rules/02-locked-stack.md)
# ============================================================================
#
# Flutterwave has TWO generations of API credentials, and they are NOT
# interchangeable. The code in src/lib/flutterwave/ targets v3.
#
# FLW_BASE_URL must match the generation of your key. Sending a v3
# FLWSECK_TEST- key to the v4 host returns HTTP 401 / code 10401.
#   v3: https://api.flutterwave.com/v3
#   v4: https://developersandbox-api.flutterwave.com
FLW_BASE_URL="https://api.flutterwave.com/v3"

# ---------------------------------------------------------------------------
# v3 API credentials — Dashboard → Settings → API
# Keys look like FLWSECK_TEST-xxxxxxxx / FLWPUBK_TEST-xxxxxxxx
# ---------------------------------------------------------------------------
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# Only needed for encrypted direct card charges. The hosted-checkout flow
# this app uses does not touch it.
FLW_ENCRYPTION_KEY=

# Numeric Payment Plan IDs — Dashboard → Payment Plans, or POST /v3/payment-plans.
# Passing one at charge time is what makes the payment recurring; while these
# are empty, checkout is a ONE-OFF payment and no subscription is created.
FLW_PLAN_MONTHLY=
FLW_PLAN_YEARLY=

# ---------------------------------------------------------------------------
# v4 API — documented here only; unused while on v3. Do not set these
# alongside a v3 key.
# ---------------------------------------------------------------------------
# FLW_CLIENT_ID=
# FLW_CLIENT_SECRET=
# FLW_OAUTH_TOKEN_URL="https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token"

# ---------------------------------------------------------------------------
# Webhooks (same in both generations)
# ---------------------------------------------------------------------------
# The secret hash you set in Dashboard → Settings → Webhooks. Flutterwave
# signs each webhook body with HMAC-SHA256 using this value and sends the
# result in the `flutterwave-signature` header.
# Retries: 3 attempts, 30 minutes apart, 60s timeout per attempt.
#
# NOTE on v3 vs v4: on v3 Flutterwave sends this value *verbatim* in a
# `verif-hash` header (verification is a direct string comparison). On v4 it
# sends HMAC-SHA256(secretHash, rawBody) in a `flutterwave-signature` header.
# src/lib/flutterwave/verifySignature.ts accepts either.
FLW_SECRET_HASH=

# --- Offline test mode ----------------------------------------------------
# true  = fake Flutterwave responses (used by the tests/ suite only)
# false = always call Flutterwave for real
# Must be false/absent whenever testing real payments: when true, checkout
# reports success without any money moving.
FLW_MOCK_MODE=false

# ============================================================================
# Auth & Application Config
# ============================================================================
APP_URL="http://localhost:3000"
AUTH_SECRET="super-secret-auth-key-change-in-production-min-32-chars"

# ============================================================================
# Nodemailer Email Service
# ============================================================================
# Note: with Gmail, SMTP_FROM must match SMTP_USER (or be a verified
# "Send mail as" alias) or the send is rejected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Subscription System <no-reply@subscriptionsystem.local>"
